{
  "name": "evenly",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-evenly",
    "build": "tsc -b && vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:rules": "node scripts/test-rules.mjs",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:rules",
    "preview:lan": "node scripts/preview-lan.mjs",
    "demo:reset": "node scripts/seed-demo.mjs --reset",
    "android:dev": "node scripts/android.mjs dev",
    "android:release": "node scripts/android.mjs release",
    "android:key": "node scripts/android.mjs key"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor-firebase/firestore": "^8.5.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
